{
  "scripts": {
    "install": "npm ci",
    "build": "npm run build",
    "publish": "npm publish --access public",
    "sync-deps": "node ./scripts/sync-deps.js",
    "npm-install": "npm install --package-lock-only",
    "npm-login": "npm whoami || npm login",
    "smoke-test": "npm run smoke",
    "announce": "./scripts/announce.sh",
    "build-go": "go build ./...",
    "publish-go": "./scripts/release.sh",
    "notify": "./scripts/notify.sh"
  },
  "spaces": {
    "libs": {
      "path": "packages/libs",
      "isBuildWaitingPublish": true,
      "revertOnFail": true,
      "versioning": "independent",
      "runScripts": {
        "lint": "npm run lint"
      },
      "autoVersion": {
        "match": ["workspace:*"],
        "range": "caret",
        "kinds": ["dependencies", "devDependencies", "peerDependencies"],
        "syncLock": ["npm-install"],
        "syncLockConcurrency": 1
      },
      "flow": {
        "build": ["install", "build"],
        "publish": "publish",
        "version": "sync-deps",
        "login": "npm-login",
        "postBuild": "smoke-test",
        "announce": "announce"
      },
      "packages": {
        "core": {
          "revertOnFail": false,
          "flow": { "build": "build" },
          "versionGroup": "platform",
          "concurrency": [2, 1],
          "changelog": { "file": "HISTORY.md" },
          "github": { "enabled": false }
        }
      }
    },
    "apps": {
      "path": "packages/apps",
      "isBuildWaitingPublish": false,
      "flow": {
        "build": "build-go",
        "publish": "publish-go"
      },
      "tagFormat": "packages/apps/{name}@v{version}"
    }
  },
  "versionGroups": {
    "platform": { "versioning": "fixed" }
  },
  "run": {"postAll": "notify"},
  "dependencies": [
    { "consumer": "app", "provider": "core" },
    { "consumer": "app", "provider": "utils", "keep": true }
  ],
  "initials": {
    "core": "1.0.0"
  },
  "tagFormat": "{name}@{version}",
  "commitErrors": "warn",
  "nonPackageScopes": ["release"],
  "concurrency": [4, 2],
  "logLevel": "info",
  "logFormat": "pretty",
  "shell": ["/bin/sh", "-c"],
  "parser": {
    "propagation": { "depth": 0 }
  },
  "changelog": {
    "enabled": true,
    "file": "CHANGELOG.md",
    "title": "# Changelog",
    "dateFormat": "2006-01-02",
    "breakingTitle": "Breaking Changes",
    "featuresTitle": "Features",
    "fixesTitle": "Fixes",
    "dependenciesTitle": "Dependencies"
  },
  "commit": {
    "enabled": false,
    "messageFormat": "chore(release): {tags}",
    "push": false,
    "remote": "origin",
    "verify": true
  },
  "github": {
    "enabled": true,
    "owner": "acme",
    "repo": "monorepo",
    "apiUrl": "https://api.github.com",
    "tokenEnv": "GITHUB_TOKEN",
    "featuresTitle": "Features"
  }
}
