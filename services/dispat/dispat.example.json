{
  "scripts": {
    "install": "npm ci",
    "build": "npm run build",
    "publish": "npm publish --access public",
    "sync-deps": "node ./scripts/sync-deps.js",
    "npm-install": "npm install --package-lock-only",
    "npm-login": "npm whoami || npm login",
    "smoke-test": "npm run smoke",
    "announce": "./scripts/announce.sh",
    "build-go": "go build ./...",
    "publish-go": "./scripts/release.sh",
    "notify": "./scripts/notify.sh"
  },
  "spaces": {
    "libs": {
      "path": "packages/libs",
      "isBuildWaitingPublish": true,
      "revertOnFail": true,
      "versioning": "independent",
      "scripts": {
        "lint": "npm run lint"
      },
      "env": {
        "GOFLAGS": "-mod=mod"
      },
      "custom": {
        "owner": "libs-team"
      },
      "autoVersion": {
        "match": [
          "workspace:*"
        ],
        "range": "caret",
        "kinds": [
          "dependencies",
          "devDependencies",
          "peerDependencies"
        ],
        "replace": [
          {
            "files": [
              "*.gradle"
            ],
            "find": "com.acme:{provider}:{providerPrevious}",
            "write": "com.acme:{provider}:{providerVersion}"
          }
        ],
        "syncLock": [
          "npm-install"
        ],
        "syncLockConcurrency": 1
      },
      "flow": {
        "build": [
          "install",
          "build"
        ],
        "publish": "publish",
        "version": "sync-deps",
        "login": "npm-login",
        "postBuild": "smoke-test",
        "announce": "announce"
      }
    },
    "apps": {
      "path": "packages/apps",
      "isBuildWaitingPublish": false,
      "flow": {
        "build": "build-go",
        "publish": "publish-go"
      },
      "tagFormat": "packages/apps/{name}@v{version}"
    }
  },
  "packages": {
    "core": {
      "revertOnFail": false,
      "scripts": {
        "lint": "npm run lint -- --strict"
      },
      "flow": {
        "build": "build"
      },
      "versionGroup": "platform",
      "concurrency": [
        2,
        1
      ],
      "changelog": {
        "file": "HISTORY.md"
      },
      "github": {
        "enabled": false
      },
      "manifestNames": [
        "com.acme:core"
      ],
      "src": "lib",
      "ignore": [
        "docs/",
        "*.snap",
        "!docs/api.md"
      ]
    },
    "cli": {
      "path": "tools/cli",
      "flow": {
        "build": "build-go",
        "publish": "publish-go"
      },
      "dependencies": [
        "core",
        {
          "provider": "utils",
          "keep": true
        }
      ],
      "aliasTags": [
        {
          "format": "cli-v{version}"
        },
        {
          "format": "cli-v{major}",
          "moving": true,
          "channels": [
            "stable"
          ]
        }
      ]
    }
  },
  "versionGroups": {
    "platform": {
      "versioning": "fixed"
    }
  },
  "run": {
    "allowBranch": [
      "main",
      "release/*"
    ],
    "postAll": "notify"
  },
  "env": {
    "NPM_CONFIG_REGISTRY": "https://registry.npmjs.org",
    "CUSTOM_TAG": "custom_$DISPAT_VERSION"
  },
  "custom": {
    "team": "platform"
  },
  "dependencies": {
    "app": [
      "core",
      {
        "provider": "utils",
        "keep": true
      }
    ]
  },
  "initials": {
    "core": "1.0.0"
  },
  "tagFormat": "{name}@{version}",
  "commitErrors": "warn",
  "nonPackageScopes": [
    "release"
  ],
  "concurrency": [
    4,
    2
  ],
  "logLevel": "info",
  "logFormat": "pretty",
  "unsafeDisableLock": false,
  "shell": [
    "/bin/sh",
    "-c"
  ],
  "parser": {
    "propagation": {
      "depth": 0
    }
  },
  "changelog": {
    "enabled": true,
    "file": "CHANGELOG.md",
    "fileTitle": "# Changelog",
    "dateFormat": "2006-01-02",
    "breakingTitle": "Breaking Changes",
    "featuresTitle": "Features",
    "fixesTitle": "Fixes",
    "dependenciesTitle": "Dependencies",
    "footer": [
      {
        "line": "Published from the acme monorepo.",
        "space": "libs"
      }
    ]
  },
  "commit": {
    "enabled": false,
    "messageFormat": "chore(release): {tags}",
    "push": false,
    "remote": "origin",
    "verify": true
  },
  "github": {
    "enabled": true,
    "owner": "acme",
    "repo": "monorepo",
    "apiUrl": "https://api.github.com",
    "tokenEnv": "GITHUB_TOKEN",
    "featuresTitle": "Features",
    "releaseName": "${DISPAT_PACKAGE} ${DISPAT_VERSION}",
    "footer": [
      "Changelog: https://github.com/acme/monorepo/blob/${DISPAT_TAG}/CHANGELOG.md"
    ]
  }
}
