{
  "scripts": {
    "go-mod-tidy": "go mod tidy",
    "pnpm-install": "pnpm install",
    "changelog": "dispat changelog",
    "commit": "dispat commit --tag --push",
    "github": "dispat github",
    "build-dispat": "sh ../../scripts/build-dispat.sh",
    "build-docs": "pnpm install --frozen-lockfile && pnpm run build",
    "cut-docs-version": "sh ../../scripts/cut-docs-version.sh",
    "deploy-docs": "sh ../../scripts/deploy-docs.sh",
    "tag-action": "sh ../../scripts/tag-action.sh",
    "docker-login": "printf '%s' \"$DOCKERHUB_TOKEN\" | docker login -u \"$DOCKERHUB_USERNAME\" --password-stdin",
    "build-image": "docker compose -f docker-compose.yml -f $DISPAT_CHANNEL.yml build",
    "push-image": "docker compose -f docker-compose.yml -f $DISPAT_CHANNEL.yml push"
  },
  "versionGroups": {
    "manifests": {
      "versioning": "fixed"
    },
    "cli": {
      "versioning": "fixedMajorMinor"
    }
  },
  "spaces": {
    "pkg": {
      "tagFormat": "pkg/{name}/v{version}",
      "path": "pkg",
      "isBuildWaitingPublish": true,
      "autoVersion": {
        "enabled": true,
        "syncLock": [
          "go-mod-tidy"
        ]
      },
      "flow": {
        "beforePublish": [
          "changelog",
          "commit"
        ]
      },
      "packages": {
        "manifest": {
          "versionGroup": "manifests"
        },
        "scanner": {
          "versionGroup": "manifests"
        },
        "writer": {
          "versionGroup": "manifests"
        },
        "models": {
          "versionGroup": "cli"
        }
      }
    },
    "packages": {
      "path": "packages",
      "autoVersion": {
        "enabled": true,
        "syncLock": [
          "pnpm-install"
        ]
      },
      "packages": {
        "docs": {
          "tagFormat": "packages/docs/v{version}",
          "versionGroup": "cli",
          "flow": {
            "version": "cut-docs-version",
            "build": "build-docs",
            "publish": "deploy-docs",
            "beforePublish": [
              "changelog",
              "commit"
            ]
          }
        }
      }
    },
    "services": {
      "tagFormat": "services/{name}/v{version}",
      "path": "services",
      "isBuildWaitingPublish": true,
      "autoVersion": {
        "enabled": true,
        "syncLock": [
          "go-mod-tidy"
        ]
      },
      "flow": {
        "beforePublish": [
          "changelog",
          "commit",
          "github"
        ]
      },
      "packages": {
        "dispat": {
          "versionGroup": "cli",
          "flow": {
            "build": "build-dispat",
            "announce": "tag-action"
          }
        }
      }
    },
    "docker": {
      "tagFormat": "docker/{name}/v{version}",
      "path": "docker",
      "autoVersion": {
        "enabled": true
      },
      "flow": {
        "login": "docker-login",
        "build": "build-image",
        "publish": "push-image",
        "beforePublish": [
          "changelog",
          "commit"
        ]
      },
      "packages": {
        "dispat-ubuntu": {
          "versionGroup": "cli",
          "manifestNames": [
            "docker.io/yohimik/dispat-ubuntu"
          ]
        },
        "dispat-debian": {
          "versionGroup": "cli",
          "manifestNames": [
            "docker.io/yohimik/dispat-debian"
          ]
        },
        "dispat-alpine": {
          "versionGroup": "cli",
          "manifestNames": [
            "docker.io/yohimik/dispat-alpine"
          ]
        },
        "dispat-dind": {
          "versionGroup": "cli",
          "manifestNames": [
            "docker.io/yohimik/dispat-dind"
          ]
        }
      }
    }
  },
  "dependencies": [
    {
      "consumer": "dispat",
      "provider": "ccme"
    },
    {
      "consumer": "dispat",
      "provider": "manifest"
    },
    {
      "consumer": "dispat",
      "provider": "models"
    },
    {
      "consumer": "dispat",
      "provider": "scanner"
    },
    {
      "consumer": "dispat",
      "provider": "writer"
    },
    {
      "consumer": "models",
      "provider": "ccme"
    },
    {
      "consumer": "scanner",
      "provider": "manifest"
    },
    {
      "consumer": "writer",
      "provider": "manifest"
    },
    {
      "consumer": "docs",
      "provider": "dispat",
      "keep": true
    },
    {
      "consumer": "dispat-ubuntu",
      "provider": "dispat",
      "keep": true
    },
    {
      "consumer": "dispat-debian",
      "provider": "dispat",
      "keep": true
    },
    {
      "consumer": "dispat-alpine",
      "provider": "dispat",
      "keep": true
    },
    {
      "consumer": "dispat-dind",
      "provider": "dispat",
      "keep": true
    }
  ],
  "concurrency": [
    0,
    1
  ],
  "changelog": {
    "enabled": true
  },
  "commit": {
    "enabled": true,
    "push": true,
    "name": "github-actions[bot]",
    "email": "github-actions[bot]@users.noreply.github.com"
  },
  "github": {
    "enabled": true,
    "allPackages": true
  }
}
