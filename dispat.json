{
  "scripts": {
    "go-mod-tidy": "go mod tidy",
    "changelog": "dispat changelog",
    "commit": "dispat commit --tag --push",
    "build-dispat": "sh ../../scripts/build-dispat.sh",
    "build-docs": "pnpm install --frozen-lockfile && pnpm run build",
    "cut-docs-version": "sh ../../scripts/cut-docs-version.sh",
    "deploy-docs": "sh ../../scripts/deploy-docs.sh"
  },
  "packages": {
    "dispat": {
      "flow": {
        "build": "build-dispat"
      }
    },
    "docs": {
      "path": "packages/docs",
      "tagFormat": "packages/docs/v{version}",
      "flow": {
        "version": "cut-docs-version",
        "build": "build-docs",
        "publish": "deploy-docs",
        "beforePublish": [
          "changelog",
          "commit"
        ]
      }
    },
    "manifest": {
      "versionGroup": "manifests"
    },
    "scanner": {
      "versionGroup": "manifests"
    },
    "writer": {
      "versionGroup": "manifests"
    }
  },
  "spaces": {
    "pkg": {
      "tagFormat": "pkg/{name}/v{version}",
      "path": "pkg",
      "isBuildWaitingPublish": true,
      "autoVersion": {
        "enabled": true,
        "syncLock": [
          "go-mod-tidy"
        ]
      },
      "flow": {
        "beforePublish": [
          "changelog",
          "commit"
        ]
      }
    },
    "services": {
      "tagFormat": "services/{name}/v{version}",
      "path": "services",
      "autoVersion": {
        "enabled": true,
        "syncLock": [
          "go-mod-tidy"
        ]
      },
      "flow": {
        "beforePublish": [
          "changelog",
          "commit"
        ]
      }
    }
  },
  "dependencies": [
    {
      "consumer": "dispat",
      "provider": "ccme"
    },
    {
      "consumer": "dispat",
      "provider": "manifest"
    },
    {
      "consumer": "dispat",
      "provider": "models"
    },
    {
      "consumer": "dispat",
      "provider": "scanner"
    },
    {
      "consumer": "dispat",
      "provider": "writer"
    },
    {
      "consumer": "models",
      "provider": "ccme"
    },
    {
      "consumer": "scanner",
      "provider": "manifest"
    },
    {
      "consumer": "writer",
      "provider": "manifest"
    },
    {
      "consumer": "docs",
      "provider": "dispat",
      "keep": true
    }
  ],
  "concurrency": [
    0,
    1
  ],
  "changelog": {
    "enabled": true
  },
  "commit": {
    "enabled": true,
    "push": true,
    "name": "github-actions[bot]",
    "email": "github-actions[bot]@users.noreply.github.com"
  },
  "github": {
    "enabled": true,
    "allPackages": true
  },
  "versionGroups": {
    "manifests": {
      "versioning": "fixed"
    }
  }
}
