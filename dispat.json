{
  "scripts": {
    "go-mod-tidy": "go mod tidy",
    "build-dispat": "sh ../../scripts/build-dispat.sh"
  },
  "packages": {
    "dispat": {
      "flow": {
        "build": "build-dispat"
      }
    }
  },
  "spaces": {
    "pkg": {
      "tagFormat": "pkg/{name}/v{version}",
      "path": "pkg",
      "autoVersion": {
        "enabled": true,
        "syncLock": ["go-mod-tidy"]
      }
    },
    "services": {
      "tagFormat": "services/{name}/v{version}",
      "path": "services",
      "autoVersion": {
        "enabled": true,
        "syncLock": ["go-mod-tidy"]
      }
    }
  },
  "dependencies": [
    {
      "consumer": "dispat",
      "provider": "ccme"
    },
    {
      "consumer": "dispat",
      "provider": "manifest"
    },
    {
      "consumer": "dispat",
      "provider": "models"
    },
    {
      "consumer": "dispat",
      "provider": "scanner"
    },
    {
      "consumer": "dispat",
      "provider": "writer"
    },
    {
      "consumer": "models",
      "provider": "ccme"
    },
    {
      "consumer": "scanner",
      "provider": "manifest"
    },
    {
      "consumer": "writer",
      "provider": "manifest"
    }
  ],
  "commit": {
    "enabled": true,
    "push": true
  }
}
