{
  "scripts": {
    "go-mod-tidy": "go mod tidy",
    "push-tag": "git push origin $DISPAT_TAG",
    "delete-remote-tag": "git push origin --delete $DISPAT_TAG"
  },
  "spaces": {
    "pkg": {
      "tagFormat": "pkg/{name}/v{version}",
      "path": "pkg",
      "autoVersion": {
        "enabled": true,
        "syncLock": ["go-mod-tidy"]
      },
      "flow": {
        "postPublish": "push-tag",
        "onFail": "delete-remote-tag"
      }
    },
    "services": {
      "tagFormat": "services/{name}/v{version}",
      "path": "services",
      "autoVersion": {
        "enabled": true,
        "syncLock": ["go-mod-tidy"]
      },
      "flow": {
        "postPublish": "push-tag",
        "onFail": "delete-remote-tag"
      }
    }
  },
  "dependencies": [
    {
      "consumer": "dispat",
      "provider": "ccme"
    },
    {
      "consumer": "dispat",
      "provider": "manifest"
    },
    {
      "consumer": "dispat",
      "provider": "models"
    },
    {
      "consumer": "dispat",
      "provider": "scanner"
    },
    {
      "consumer": "dispat",
      "provider": "writer"
    },
    {
      "consumer": "models",
      "provider": "ccme"
    },
    {
      "consumer": "scanner",
      "provider": "manifest"
    },
    {
      "consumer": "writer",
      "provider": "manifest"
    }
  ]
}
