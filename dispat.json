{
  "scripts": {
    "go-mod-tidy": "go mod tidy",
    "commit-module": "sh ../../scripts/commit-module.sh",
    "push-tag": "git push -f origin $DISPAT_TAG",
    "build-dispat": "sh ../../scripts/build-dispat.sh"
  },
  "packages": {
    "dispat": {
      "flow": {
        "build": "build-dispat"
      }
    }
  },
  "spaces": {
    "pkg": {
      "tagFormat": "pkg/{name}/v{version}",
      "path": "pkg",
      "isBuildWaitingPublish": true,
      "autoVersion": {
        "enabled": true,
        "syncLock": ["go-mod-tidy"]
      },
      "flow": {
        "beforePublish": "commit-module",
        "postPublish": "push-tag"
      }
    },
    "services": {
      "tagFormat": "services/{name}/v{version}",
      "path": "services",
      "autoVersion": {
        "enabled": true,
        "syncLock": ["go-mod-tidy"]
      },
      "flow": {
        "beforePublish": "commit-module",
        "postPublish": "push-tag"
      }
    }
  },
  "dependencies": [
    {
      "consumer": "dispat",
      "provider": "ccme"
    },
    {
      "consumer": "dispat",
      "provider": "manifest"
    },
    {
      "consumer": "dispat",
      "provider": "models"
    },
    {
      "consumer": "dispat",
      "provider": "scanner"
    },
    {
      "consumer": "dispat",
      "provider": "writer"
    },
    {
      "consumer": "models",
      "provider": "ccme"
    },
    {
      "consumer": "scanner",
      "provider": "manifest"
    },
    {
      "consumer": "writer",
      "provider": "manifest"
    }
  ],
  "concurrency": [0, 1],
  "changelog": {
    "enabled": false
  }
}
