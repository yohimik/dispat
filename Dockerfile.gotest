# syntax=docker/dockerfile:1
#
# Every Go gate of the monorepo, containerised: one stage per package for vet
# and tests, the post-version release gate, and the sweep-wide checks (gofmt,
# the coverage badge, the test report, go.mod tidying). A CI job needs a Go
# toolchain for none of them; the dispat scripts drive `docker buildx build`
# against a target here and read the results back as exported files.
#
# The layout is the cache strategy. Dependencies download in one layer keyed
# on nothing but the lockfiles, each package's stage copies only its own
# source and the workspace providers it imports, and every gate is a RUN on
# top. A package that did not change is a chain of cache hits even under a
# `--since all` sweep; the packages that changed are the only ones that
# re-execute. The release's version rewrite edits a released module's go.mod,
# which busts exactly that module's layers, so the post-version gate always
# runs for real on releasing code.
#
# debian-based golang, not alpine: the integration race pass needs cgo, and
# the suites drive git, both of which this image carries already.
ARG GO_VERSION=1.26

# Everything below the user line runs as gopher, not root, and every COPY
# hands its files to gopher. Not hygiene: the suites inject failures by
# making folders read-only, and root does not honour file permissions, so a
# root run turns those tests' expected errors into successes that fail them.
FROM golang:${GO_VERSION} AS base
RUN useradd --create-home --uid 1001 gopher
WORKDIR /src
RUN chown gopher:gopher /src
# The same bypass the workflows and the smoke stage use: intra-repo modules
# are fetched from their tags directly, not from a proxy that may not have
# seen a tag dispat itself created moments ago. The update check would have
# instrumented binaries under test phone the GitHub API.
ENV GOPRIVATE=github.com/yohimik/dispat
ENV DISPAT_UPDATE_CHECK=false
ENV GOPATH=/home/gopher/go
ENV GOCACHE=/home/gopher/.cache/go-build
USER gopher

# The dependency layer every workspace gate shares: the manifests alone,
# before any source, so it survives every edit that does not change a
# dependency. No cache mount on the download on purpose — a mount's contents
# never leave the builder, and this layer is what the CI cache backend
# carries between runs.
FROM base AS deps
COPY --chown=gopher:gopher go.work go.work.sum ./
# ccme and manifest carry no go.sum: they have no module dependencies
# to sum, and a COPY that names a file that does not exist fails the build.
COPY --chown=gopher:gopher pkg/ccme/go.mod pkg/ccme/
COPY --chown=gopher:gopher pkg/config/go.mod pkg/config/go.sum pkg/config/
COPY --chown=gopher:gopher pkg/manifest/go.mod pkg/manifest/
COPY --chown=gopher:gopher pkg/models/go.mod pkg/models/go.sum pkg/models/
COPY --chown=gopher:gopher pkg/scanner/go.mod pkg/scanner/go.sum pkg/scanner/
COPY --chown=gopher:gopher pkg/writer/go.mod pkg/writer/go.sum pkg/writer/
COPY --chown=gopher:gopher services/dispat/go.mod services/dispat/go.sum services/dispat/
COPY --chown=gopher:gopher tests/integration/go.mod tests/integration/go.sum tests/integration/
COPY --chown=gopher:gopher tools/go.mod tools/go.sum tools/
RUN go mod download

# testreport rides along with every suite (each tests script runs through it),
# so it sits between the dependency layer and the per-package sources: a
# tooling change re-runs every suite, a package change re-runs one.
FROM deps AS runner
COPY --chown=gopher:gopher tools ./tools

# Tools conformance tests import the workspace scanner while keeping Aqua's
# dependency graph out of the production module.
FROM runner AS src-tools
COPY --chown=gopher:gopher pkg/manifest ./pkg/manifest
COPY --chown=gopher:gopher pkg/scanner ./pkg/scanner

# One source stage per package: its own folder plus the workspace providers
# its go.mod requires, and nothing else. What a stage copies is what busts
# its cache, so the copy lists are the isolation.
FROM runner AS src-ccme
COPY --chown=gopher:gopher pkg/ccme ./pkg/ccme

FROM runner AS src-config
COPY --chown=gopher:gopher pkg/config ./pkg/config

FROM runner AS src-manifest
COPY --chown=gopher:gopher pkg/manifest ./pkg/manifest

FROM runner AS src-models
COPY --chown=gopher:gopher pkg/ccme ./pkg/ccme
COPY --chown=gopher:gopher pkg/models ./pkg/models

FROM runner AS src-scanner
COPY --chown=gopher:gopher pkg/manifest ./pkg/manifest
COPY --chown=gopher:gopher pkg/scanner ./pkg/scanner

FROM runner AS src-writer
COPY --chown=gopher:gopher pkg/manifest ./pkg/manifest
COPY --chown=gopher:gopher pkg/writer ./pkg/writer

# The dispat suite reads beyond its module: the selfupdate tests hold
# install.sh, install.ps1 and the four image folders to the CLI's own asset
# names, and the plan tests hold the diagnostic codes to the spec and the
# architecture page. Those files are inputs to this suite as much as any
# source file is, so they are copied — and a change to any of them re-runs
# the suite, which is exactly what those tests are for.
FROM runner AS src-dispat
COPY --chown=gopher:gopher pkg ./pkg
COPY --chown=gopher:gopher services/dispat ./services/dispat
COPY --chown=gopher:gopher install.sh install.ps1 ./
COPY --chown=gopher:gopher docker ./docker
COPY --chown=gopher:gopher specs/ccme-spec/SPEC.md ./specs/ccme-spec/SPEC.md
COPY --chown=gopher:gopher packages/docs/docs/internals/architecture.md ./packages/docs/docs/internals/architecture.md

FROM src-dispat AS src-integration
COPY --chown=gopher:gopher tests/integration ./tests/integration
COPY --chown=gopher:gopher packages/cli/dispat.yaml ./packages/cli/dispat.yaml
COPY --chown=gopher:gopher packages/docs/dispat.yaml ./packages/docs/dispat.yaml
COPY --chown=gopher:gopher packages/docs/demo ./packages/docs/demo

# The lint gate, one target per module: what `dispat run vet --since all`
# sweeps. vet compiles what it analyses, so these are the build gates too.
# The go-build cache mounts speed the many sequential per-package builds one
# CI job runs through a single builder; they are deliberately not part of the
# cross-run cache story, the layers above are.
FROM src-ccme AS vet-ccme
RUN --mount=type=cache,target=/home/gopher/.cache/go-build,uid=1001,gid=1001 \
    go vet -C pkg/ccme ./...

FROM src-config AS vet-config
RUN --mount=type=cache,target=/home/gopher/.cache/go-build,uid=1001,gid=1001 \
    go vet -C pkg/config ./...

FROM src-manifest AS vet-manifest
RUN --mount=type=cache,target=/home/gopher/.cache/go-build,uid=1001,gid=1001 \
    go vet -C pkg/manifest ./...

FROM src-models AS vet-models
RUN --mount=type=cache,target=/home/gopher/.cache/go-build,uid=1001,gid=1001 \
    go vet -C pkg/models ./...

FROM src-scanner AS vet-scanner
RUN --mount=type=cache,target=/home/gopher/.cache/go-build,uid=1001,gid=1001 \
    go vet -C pkg/scanner ./...

FROM src-writer AS vet-writer
RUN --mount=type=cache,target=/home/gopher/.cache/go-build,uid=1001,gid=1001 \
    go vet -C pkg/writer ./...

FROM src-dispat AS vet-dispat
RUN --mount=type=cache,target=/home/gopher/.cache/go-build,uid=1001,gid=1001 \
    go vet -C services/dispat ./...

FROM src-tools AS vet-tools
RUN --mount=type=cache,target=/home/gopher/.cache/go-build,uid=1001,gid=1001 \
    go vet -C tools ./...

FROM src-integration AS vet-integration
RUN --mount=type=cache,target=/home/gopher/.cache/go-build,uid=1001,gid=1001 \
    go vet -C tests/integration ./...

# The test gates: the exact commands the packages' tests scripts have always
# run, with /src/coverage as the profile destination the export stages read.
# Identical inputs produce a cache hit, which replays the recorded result and
# still exports the recorded profile — that is the sweep's incrementality,
# not a gap in it.
#
# TEST_COMMIT deliberately enters each test stage after the expensive RUN.
# BuildKit can therefore reuse a result only when every preceding Docker
# input (tooling, module source and declared fixtures) is identical. The
# following layer attests that content-identical measurement for this commit;
# it does not turn a result from different source into a fresh profile.
FROM src-ccme AS test-ccme
RUN --mount=type=cache,target=/home/gopher/.cache/go-build,uid=1001,gid=1001 \
    cd pkg/ccme && go run github.com/yohimik/dispat/tools/testreport test ccme -- \
    ./... -count=1 -timeout 10m -covermode=atomic -coverprofile=/src/coverage/ccme.out
ARG TEST_COMMIT
RUN test -n "$TEST_COMMIT" && printf '%s\n' "$TEST_COMMIT" > /src/coverage/ccme.commit
FROM scratch AS export-ccme
COPY --from=test-ccme /src/coverage /

FROM src-config AS test-config
RUN --mount=type=cache,target=/home/gopher/.cache/go-build,uid=1001,gid=1001 \
    cd pkg/config && go run github.com/yohimik/dispat/tools/testreport test config -- \
    ./... -count=1 -timeout 10m -covermode=atomic -coverprofile=/src/coverage/config.out
ARG TEST_COMMIT
RUN test -n "$TEST_COMMIT" && printf '%s\n' "$TEST_COMMIT" > /src/coverage/config.commit
FROM scratch AS export-config
COPY --from=test-config /src/coverage /

FROM src-manifest AS test-manifest
RUN --mount=type=cache,target=/home/gopher/.cache/go-build,uid=1001,gid=1001 \
    cd pkg/manifest && go run github.com/yohimik/dispat/tools/testreport test manifest -- \
    ./... -count=1 -timeout 10m -covermode=atomic -coverprofile=/src/coverage/manifest.out
ARG TEST_COMMIT
RUN test -n "$TEST_COMMIT" && printf '%s\n' "$TEST_COMMIT" > /src/coverage/manifest.commit
FROM scratch AS export-manifest
COPY --from=test-manifest /src/coverage /

FROM src-models AS test-models
RUN --mount=type=cache,target=/home/gopher/.cache/go-build,uid=1001,gid=1001 \
    cd pkg/models && go run github.com/yohimik/dispat/tools/testreport test models -- \
    ./... -count=1 -timeout 10m -covermode=atomic -coverprofile=/src/coverage/models.out
ARG TEST_COMMIT
RUN test -n "$TEST_COMMIT" && printf '%s\n' "$TEST_COMMIT" > /src/coverage/models.commit
FROM scratch AS export-models
COPY --from=test-models /src/coverage /

FROM src-scanner AS test-scanner
RUN --mount=type=cache,target=/home/gopher/.cache/go-build,uid=1001,gid=1001 \
    cd pkg/scanner && go run github.com/yohimik/dispat/tools/testreport test scanner -- \
    ./... -count=1 -timeout 10m -covermode=atomic -coverprofile=/src/coverage/scanner.out
ARG TEST_COMMIT
RUN test -n "$TEST_COMMIT" && printf '%s\n' "$TEST_COMMIT" > /src/coverage/scanner.commit
FROM scratch AS export-scanner
COPY --from=test-scanner /src/coverage /

FROM src-writer AS test-writer
RUN --mount=type=cache,target=/home/gopher/.cache/go-build,uid=1001,gid=1001 \
    cd pkg/writer && go run github.com/yohimik/dispat/tools/testreport test writer -- \
    ./... -count=1 -timeout 10m -covermode=atomic -coverprofile=/src/coverage/writer.out
ARG TEST_COMMIT
RUN test -n "$TEST_COMMIT" && printf '%s\n' "$TEST_COMMIT" > /src/coverage/writer.commit
FROM scratch AS export-writer
COPY --from=test-writer /src/coverage /

# The shared tool bootstrap, exercised with the candidate CLI in a minimal
# fixture. The mocks replace the two downloads and nothing else, so dispat
# resolves and runs the config the release and the images actually use.
#
# python3 is installed rather than assumed. The golang image carries one only
# because buildpack-deps pulls it in for mercurial, and a gate resting on
# another package's dependency is a gate that disappears the day that
# dependency does.
FROM src-dispat AS test-bootstrap
USER root
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 \
 && rm -rf /var/lib/apt/lists/*
USER gopher
COPY --chown=gopher:gopher scripts/install-tools.sh scripts/test-install-tools.py ./scripts/
COPY --chown=gopher:gopher .aqua ./.aqua
RUN --mount=type=cache,target=/home/gopher/.cache/go-build,uid=1001,gid=1001 \
    go build -o /tmp/dispat-bootstrap ./services/dispat \
 && DISPAT_TEST_BINARY=/tmp/dispat-bootstrap python3 scripts/test-install-tools.py \
 && touch /tmp/bootstrap-tested

# The repository tooling's own suite, profiled like every other module's. It
# was the one suite that measured nothing, so testreport, which is what every
# other number on the site comes out of, was the only Go in the workspace the
# coverage page could not report on.
FROM src-tools AS test-tools
COPY --from=test-bootstrap /tmp/bootstrap-tested /tmp/bootstrap-tested
RUN --mount=type=cache,target=/home/gopher/.cache/go-build,uid=1001,gid=1001 \
    cd tools && go run github.com/yohimik/dispat/tools/testreport test tools -- \
    ./... -count=1 -covermode=atomic -coverprofile=/src/coverage/tools.out
ARG TEST_COMMIT
RUN test -n "$TEST_COMMIT" && printf '%s\n' "$TEST_COMMIT" > /src/coverage/tools.commit
FROM scratch AS export-tools
COPY --from=test-tools /src/coverage /

FROM src-dispat AS test-dispat
RUN --mount=type=cache,target=/home/gopher/.cache/go-build,uid=1001,gid=1001 \
    cd services/dispat && go run github.com/yohimik/dispat/tools/testreport test dispat -- \
    ./... -count=1 -timeout 10m -covermode=atomic -coverpkg=./... -coverprofile=/src/coverage/dispat.out
ARG TEST_COMMIT
RUN test -n "$TEST_COMMIT" && printf '%s\n' "$TEST_COMMIT" > /src/coverage/dispat.commit
FROM scratch AS export-dispat
COPY --from=test-dispat /src/coverage /

# The black-box suite: the harness builds an instrumented dispat from the
# workspace, drives it against disposable git repositories, and the covdata
# folder becomes integration.out. The race pass keeps its own log, as it
# always has. The export takes the profile and the logs and leaves the binary
# covdata behind.
#
# Both passes run in six go test processes over an exact round-robin split of
# the suite's tests (`testreport test --shards`), and each still leaves one
# log. The suite waits far more than it computes (polls, preflights, sleeps),
# so one process runs two to three times slower here than on a laptop, about
# twice the hour a pass is allowed; six wait side by side. Each -timeout
# bounds one shard, a sixth of the suite. Every shard's dispat writes its
# counters into the one DISPAT_COVERDIR, and every shard builds its binaries
# in a temp folder of its own.
FROM src-integration AS test-integration
RUN --mount=type=cache,target=/home/gopher/.cache/go-build,uid=1001,gid=1001 <<'EOF'
set -eu
cd services/dispat
export DISPAT_COVERDIR=/src/coverage/covdata
export DISPAT_COVERPKG='github.com/yohimik/dispat/services/dispat/...,github.com/yohimik/dispat/pkg/ccme/...,github.com/yohimik/dispat/pkg/config/...,github.com/yohimik/dispat/pkg/manifest/...,github.com/yohimik/dispat/pkg/models/...,github.com/yohimik/dispat/pkg/scanner/...,github.com/yohimik/dispat/pkg/writer/...'
rm -rf "$DISPAT_COVERDIR" && mkdir -p "$DISPAT_COVERDIR"
go run github.com/yohimik/dispat/tools/testreport test integration --shards 6 -- -C ../../tests/integration ./... \
  -count=1 -timeout 60m -covermode=atomic -coverpkg="$DISPAT_COVERPKG" \
  -coverprofile=/src/coverage/publicapi.out
go tool covdata textfmt -i="$DISPAT_COVERDIR" -o=/src/coverage/cli-integration.out
{ head -n 1 /src/coverage/cli-integration.out; tail -q -n +2 /src/coverage/cli-integration.out /src/coverage/publicapi.out; } \
  > /src/coverage/integration.out
# Every black-box CLI is race-instrumented. Go's default one-second race
# runtime exit sleep would therefore be paid hundreds of times. Reports go
# to a shared directory so TestMain can fail even when a scenario expects the
# child's non-zero (normally exit 66) status. The six shards share it too, so
# a report fails every shard that checks the directory after it was written.
race_log_dir=/tmp/dispat-race-reports
rm -rf "$race_log_dir" && mkdir -p "$race_log_dir"
GORACE="atexit_sleep_ms=0 log_path=$race_log_dir/race" \
  DISPAT_TEST_RACE=1 DISPAT_TEST_RACE_LOG_DIR="$race_log_dir" \
  go run github.com/yohimik/dispat/tools/testreport test integration-race --shards 6 -- \
  -C ../../tests/integration ./... -count=1 -timeout 90m -race
EOF
ARG TEST_COMMIT
RUN test -n "$TEST_COMMIT" && printf '%s\n' "$TEST_COMMIT" > /src/coverage/integration.commit
FROM scratch AS export-integration
COPY --from=test-integration /src/coverage/integration.out /integration.out
COPY --from=test-integration /src/coverage/integration.commit /integration.commit
COPY --from=test-integration /src/coverage/testlog /testlog

# The benchmark gates: one stage per module that has benchmarks, each writing
# its stream to /src/coverage/benchlog for the report to read. Separate from
# the test stages on purpose — a benchmark is a measurement rather than a
# tally, and a suite that ran with -bench would report its measurements as
# tests and its timings as coverage of nothing.
#
# -run '^$' is what keeps them measurements: without it every test runs again
# beside the benchmarks, and the timings become a number about a machine that
# was busy doing something else. -benchtime is left at go's default, because a
# measurement taken over fewer iterations than the tool chose is a measurement
# nobody can compare.
FROM src-ccme AS bench-ccme
RUN --mount=type=cache,target=/home/gopher/.cache/go-build,uid=1001,gid=1001 \
    cd pkg/ccme && go run github.com/yohimik/dispat/tools/testreport bench ccme -- \
    ./... -run '^$' -bench . -benchmem -timeout 20m
FROM scratch AS export-bench-ccme
COPY --from=bench-ccme /src/coverage /

FROM src-config AS bench-config
RUN --mount=type=cache,target=/home/gopher/.cache/go-build,uid=1001,gid=1001 \
    cd pkg/config && go run github.com/yohimik/dispat/tools/testreport bench config -- \
    ./... -run '^$' -bench . -benchmem -timeout 20m
FROM scratch AS export-bench-config
COPY --from=bench-config /src/coverage /

FROM src-dispat AS bench-dispat
RUN --mount=type=cache,target=/home/gopher/.cache/go-build,uid=1001,gid=1001 \
    cd services/dispat && go run github.com/yohimik/dispat/tools/testreport bench dispat -- \
    ./... -run '^$' -bench . -benchmem -timeout 20m
FROM scratch AS export-bench-dispat
COPY --from=bench-dispat /src/coverage /

# The post-version release gate, run from flow.beforeBuild once autoVersion
# has rewritten a releasing module's go.mod and syncLock has tidied it. No
# workspace on purpose: the module resolves its providers from the tags the
# run just pushed, exactly as `go get` will serve them to a consumer — the
# one thing no working-tree suite can prove. The go.mod-first copy keeps the
# version rewrite's cache bust scoped to the releasing module.
#
# The repository files the dispat suite reads beyond its module ride along
# for every module — see src-dispat for what holds what to what. Their
# absence failed the 1.3.0 release's gate, which the working-tree suites
# never could have caught: they run from stages that carry the files.
FROM base AS release-test
ARG MODULE
ENV GOWORK=off
COPY --chown=gopher:gopher install.sh install.ps1 /src/
COPY --chown=gopher:gopher docker /src/docker
COPY --chown=gopher:gopher specs/ccme-spec/SPEC.md /src/specs/ccme-spec/SPEC.md
COPY --chown=gopher:gopher packages/docs/docs/internals/architecture.md /src/packages/docs/docs/internals/architecture.md
COPY --chown=gopher:gopher ${MODULE}/go.mod ${MODULE}/go.su[m] /src/${MODULE}/
RUN cd /src/${MODULE} && go mod download
COPY --chown=gopher:gopher ${MODULE} /src/${MODULE}
RUN --mount=type=cache,target=/home/gopher/.cache/go-build,uid=1001,gid=1001 \
    cd /src/${MODULE} && go test ./... -count=1 -timeout 10m

# The format sweep the lint job runs: every Go source folder, one gofmt.
FROM runner AS src-all
COPY --chown=gopher:gopher pkg ./pkg
COPY --chown=gopher:gopher services/dispat ./services/dispat
COPY --chown=gopher:gopher tests ./tests
COPY --chown=gopher:gopher packages/docs/demo ./packages/docs/demo
FROM src-all AS gofmt
RUN out=$(gofmt -l .); [ -z "$out" ] || { printf '%s\n' "$out" >&2; exit 1; }

# The two document gates, on the same sweep-wide source stage: both read the
# whole first-party tree and neither writes anything.
#
# testplan holds the integration test plan and the release-candidate
# requirement matrix to the tree — every reference resolves, every integration
# test carries one goal, every requirement row's status is the one its named
# assertions support — and enforces the RC thresholds on the matrix
# percentages. namingcheck holds exported declarations to the naming rules in
# CONTRIBUTING.md, with tools/namingcheck/naming-exceptions.txt as the written
# record of what is excused and why.
#
# In Go rather than in shell because this stage carries no ripgrep and because
# a coverage percentage nobody can recompute is not evidence.
#
# The thresholds are policy: at least 95% of the matrix's requirements and
# every critical release-safety requirement mapped to a test that exists.
FROM src-all AS repo-checks
RUN --mount=type=cache,target=/home/gopher/.cache/go-build,uid=1001,gid=1001 <<'EOF'
set -eu
go run github.com/yohimik/dispat/tools/testreport testplan \
  -minimum-mapped 95 -minimum-critical 100 .
go run github.com/yohimik/dispat/tools/namingcheck .
EOF

# go.mod tidying as a build: the syncLock step regenerates a releasing
# module's go.mod and go.sum in here and exports the pair back over the
# working tree's. GOWORK off for the same reason as release-test — during a
# release the pins being tidied are the providers' just-pushed tags.
FROM base AS tidy
ARG MODULE
ENV GOWORK=off
COPY --chown=gopher:gopher ${MODULE} /src/${MODULE}
RUN cd /src/${MODULE} && go mod tidy
FROM scratch AS tidy-export
ARG MODULE
COPY --from=tidy /src/${MODULE}/go.mod /src/${MODULE}/go.su[m] /

# The coverage totals and the README badge, from the profiles a full suite
# run left in coverage/. Only a `--since all` run produces a complete set,
# which is why the release workflow is the one caller.
#
# Three views of the suite — the unit layer (the workspace modules' own
# tests), the integration layer (the black-box CLI and public API scenarios
# across all seven production modules, with no unit-test counters), with only the combined total
# across every profile (go tool cover merges the overlapping blocks) becoming
# the README badge. The summary table goes to coverage/summary.md rather than
# $GITHUB_STEP_SUMMARY, which cannot cross a build boundary; the
# coverage-badge script appends the file for the workflow.
#
# On src-all rather than base because `go tool cover -func` resolves every
# profile line back to its source file: the whole workspace has to be here
# for the totals to be about anything.
FROM src-all AS badge
ARG TEST_COMMIT
ENV TESTREPORT_COMMIT=${TEST_COMMIT}
COPY --chown=gopher:gopher coverage ./coverage
RUN <<'EOF'
set -eu
merge() { out=$1; shift; { head -n 1 "$1"; tail -q -n +2 "$@"; } > "$out"; }
pct() { go tool cover -func="$1" | tail -n 1 | awk '{print $3}'; }
badge() { # <label> <percentage> <file>: shields.io endpoint JSON
  COLOR=red
  BAND=$(printf '%.0f' "${2%\%}")
  if   [ "$BAND" -ge 92 ]; then COLOR=brightgreen
  elif [ "$BAND" -ge 85 ]; then COLOR=green
  elif [ "$BAND" -ge 75 ]; then COLOR=yellowgreen
  elif [ "$BAND" -ge 60 ]; then COLOR=yellow
  elif [ "$BAND" -ge 40 ]; then COLOR=orange
  fi
  printf '{"schemaVersion": 1, "label": "%s", "message": "%s", "color": "%s"}\n' \
    "$1" "$2" "$COLOR" > "$3"
  cat "$3"
}

# Whatever the run produced, rather than a list to keep in step with the
# monorepo: every package's tests script writes one profile named after it,
# and integration.out is the one that is not a unit layer. Collected into the
# positional parameters rather than a variable, so a profile name never goes
# through word splitting. The merge outputs are skipped explicitly: they land
# in this folder too, and a re-run would otherwise fold them into themselves.
cd coverage
test -n "$TESTREPORT_COMMIT" || { echo "TEST_COMMIT is required for a coverage artifact" >&2; exit 1; }
set --
for f in *.out; do
  case "$f" in integration.out|coverage.out|coverage-unit.out) continue ;; esac
  set -- "$@" "$f"
  stamp=${f%.out}.commit
  test -f "$stamp" || { echo "$f has no measurement stamp" >&2; exit 1; }
  test "$(cat "$stamp")" = "$TESTREPORT_COMMIT" || {
    echo "$f was not measured at $TESTREPORT_COMMIT" >&2; exit 1;
  }
done
test -f integration.commit || { echo "integration.out has no measurement stamp" >&2; exit 1; }
test "$(cat integration.commit)" = "$TESTREPORT_COMMIT" || {
  echo "integration.out was not measured at $TESTREPORT_COMMIT" >&2; exit 1;
}
echo "unit profiles: $*"
merge coverage-unit.out "$@"
merge coverage.out      "$@" integration.out
UNIT=$(pct coverage-unit.out)
INTEGRATION=$(pct integration.out)
TOTAL=$(pct coverage.out)
go run github.com/yohimik/dispat/tools/testreport coverage -coverage . \
  -commit "$TESTREPORT_COMMIT" -minimum-total 95 -minimum-integration 95
echo "unit ${UNIT} / integration ${INTEGRATION} / total ${TOTAL}"

{
  echo "### Test coverage"
  echo ""
  echo '| Layer | Statement coverage |'
  echo '|---|---|'
  echo "| unit (all modules) | ${UNIT} |"
  echo "| integration (black-box CLI and public API scenarios across all seven production modules) | ${INTEGRATION} |"
  echo "| **combined total** | **${TOTAL}** |"
} > summary.md

badge "coverage" "$TOTAL" coverage.json
EOF
FROM scratch AS badge-export
COPY --from=badge /src/coverage/coverage.json /src/coverage/coverage.out \
     /src/coverage/coverage-unit.out /src/coverage/summary.md /

# The site's report.json, from the same complete profile and log set. The
# commit arrives as a build argument because a build has no $GITHUB_SHA of
# its own.
#
# This target reads the host's coverage/ folder, so its caller is whoever just
# ran the suite: `dispat exec test-report` after `dispat run tests --since
# all`. That folder is also where a campaign of release experiments lands, so
# a host-side report carries whatever `dispat exec experiments` last recorded.
# The `measured` target below is the same report built from the stages
# themselves, for the caller that has no coverage/ folder to point at.
FROM runner AS report
ARG COMMIT
COPY --chown=gopher:gopher coverage ./coverage
RUN mkdir -p packages/docs/data \
 && go run github.com/yohimik/dispat/tools/testreport build -commit "$COMMIT" -require-fresh
FROM scratch AS report-export
COPY --from=report /src/packages/docs/data/report.json /

# The same report, self-contained: every profile, log and benchmark stream
# taken from the stage that produced it rather than from a folder the caller
# had to fill first.
#
# This is what the release run builds. The release job is a fresh checkout on
# a different runner from the job that gated it, so there is no coverage/ in
# its working tree and there was no artifact to hand it one; asking for the
# stages by name is how the release measures the numbers it is about to
# publish. Identical inputs are a cache hit against the gating job's own
# build, so the stages that did not change are replayed rather than re-run.
#
# It measures every module every time, so there is nothing to carry forward
# here: a fresh checkout holds no earlier report, and the freshness rule
# `testreport build -keep` implements is for the caller that has one. What
# this build owes the site instead is the list of modules it measured, which
# rides out beside the report as benchmarked.txt and becomes the docs build's
# per-package check.
#
# The experiments are the one section that cannot come from a stage. They run
# the published image against a registry they are allowed to break, which is a
# container of its own with a network and a docker socket, so the campaign is
# already on the host by the time this builds and arrives through the context
# like the `report` target's profiles do. The glob is what makes a run that
# recorded none still produce a report: a COPY naming a folder that is not
# there fails the build, and one whose pattern matches nothing does not. Both
# segments are globbed, not only the last: the check is an lstat of the
# literal prefix, so `coverage/experiment[s]` still fails a context in which
# coverage/ itself is absent, which is every context Docker built from a tree
# nobody has run a suite in.
FROM runner AS measured
ARG COMMIT
COPY --from=test-ccme /src/coverage ./coverage
COPY --from=test-config /src/coverage ./coverage
COPY --from=test-manifest /src/coverage ./coverage
COPY --from=test-models /src/coverage ./coverage
COPY --from=test-scanner /src/coverage ./coverage
COPY --from=test-writer /src/coverage ./coverage
COPY --from=test-tools /src/coverage ./coverage
COPY --from=test-dispat /src/coverage ./coverage
COPY --from=test-integration /src/coverage/integration.out ./coverage/integration.out
COPY --from=test-integration /src/coverage/integration.commit ./coverage/integration.commit
COPY --from=test-integration /src/coverage/testlog ./coverage/testlog
COPY --from=bench-ccme /src/coverage/benchlog ./coverage/benchlog
COPY --from=bench-config /src/coverage/benchlog ./coverage/benchlog
COPY --from=bench-dispat /src/coverage/benchlog ./coverage/benchlog
COPY --chown=gopher:gopher coverag[e]/experiment[s] ./coverage/experiments
RUN <<'EOF'
set -eu
go run github.com/yohimik/dispat/tools/testreport coverage -coverage coverage \
  -commit "$COMMIT" -minimum-total 95 -minimum-integration 95
go run github.com/yohimik/dispat/tools/testreport build -commit "$COMMIT" \
  -require-fresh -modules packages/docs/data/benchmarked.txt
EOF
FROM scratch AS measured-export
COPY --from=measured /src/packages/docs/data/report.json \
     /src/packages/docs/data/benchmarked.txt /

# The campaign's table on its own, for the job summary the experiments print
# and for a terminal. The same verb the report reads the records with, so the
# summary a run prints and the page it publishes cannot say different things
# about one set of records.
#
# On `runner` rather than a stage with the workspace in it: nothing here reads
# a source file, only the records the context carries.
FROM runner AS experiments-summary
COPY --chown=gopher:gopher coverag[e]/experiment[s] ./coverage/experiments
# mkdir before the redirect: with no campaign in the context the COPY above
# matches nothing and coverage/ does not exist, and a table of no cells is
# still the right answer to give.
RUN mkdir -p coverage \
 && go run github.com/yohimik/dispat/tools/testreport experiments -markdown \
    > coverage/experiments.md \
 && cat coverage/experiments.md
FROM scratch AS experiments-summary-export
COPY --from=experiments-summary /src/coverage/experiments.md /

# The shell sweep: every script this repository runs outside a Go program,
# through shellcheck, and the notes generator through a parser.
#
# Self-contained, on alpine rather than on the Go image, because nothing here
# needs a toolchain and a lint gate that waits for one is a lint gate people
# stop running. It is in this file rather than a Dockerfile of its own because
# the context is already the whole repository and one lint file per language
# is a file per language to keep in step.
#
# The globs are what let a folder be absent: a COPY naming a path that is not
# there fails the build, and there is no arrangement of this repository in
# which every one of these folders exists at once during a bisect.
FROM alpine:3.22 AS shellcheck
RUN apk add --no-cache shellcheck python3 jq
WORKDIR /src
COPY install.sh ./
COPY script[s] ./scripts
COPY specs/ccme-spec/*.sh ./specs/ccme-spec/
COPY specs/agent-guide/*.sh ./specs/agent-guide/
COPY tests/experiments/run.sh tests/experiments/
COPY tests/experiments/lib/common.sh tests/experiments/lib/cache*.sh tests/experiments/lib/
COPY Dockerfile.gotest ./
RUN <<'EOF'
set -eu
# POSIX sh, which is what these declare and what they are run as. The spike
# script is checked apart from the rest: it is the one script that runs
# without `set -e` on purpose (its targets never abort, the logs are what it
# produces), so shellcheck cannot see that a failing `cd` there is followed by
# commands which record their own failure. Its `cd` calls fail through `die`
# like anything fatal there; only the grouped-redirect style note (SC2129) is
# left alone, because one log line per probe is the shape its logs are read in.
sh -n install.sh
set -- install.sh
for f in scripts/*.sh specs/*/*.sh; do
  [ -f "$f" ] || continue
  case "$f" in scripts/tinygo-spike-darwin.sh) continue ;; esac
  set -- "$@" "$f"
done
echo "shellcheck (sh): $*"
shellcheck -s sh "$@"
if [ -f scripts/tinygo-spike-darwin.sh ]; then
  echo "shellcheck (sh, without SC2129): scripts/tinygo-spike-darwin.sh"
  shellcheck -s sh --exclude=SC2129 scripts/tinygo-spike-darwin.sh
fi

# The two that are bash on purpose: the harness entrypoint and its library
# use arrays and [[ ]], which is why they carry a bash shebang.
echo "shellcheck (bash): tests/experiments/run.sh tests/experiments/lib/common.sh"
shellcheck -s bash tests/experiments/run.sh tests/experiments/lib/common.sh
sh tests/experiments/lib/cache-test.sh
sh scripts/cache-test.sh /src
EOF

# The shell inside the configuration, swept the same way. Every `scripts`
# entry of a dispat config is a shell command — the tool bootstrap, the image
# builds, the site deploy, the badge push — and none of it was checked by
# anything: the sweep above reads files, and these are values inside YAML.
#
# The context is mounted rather than copied because the sweep is over whatever
# configs exist, and a COPY list is one more list to keep in step with the
# repository. It costs this layer its cache whenever anything in the context
# changes, which for an alpine stage and a few seconds of shellcheck is the
# cheaper of the two mistakes. What the context itself leaves out is decided
# by Dockerfile.gotest.dockerignore, which names every config for this reason.
RUN --mount=type=bind,target=/repo <<'EOF'
set -eu
python3 scripts/lint-config-scripts.py --self-test
cd /repo
set --
if [ -f tools/bootstrap.yaml ]; then set -- "$@" tools/bootstrap.yaml; fi
# One word per path, which every path in this repository is.
for f in $(find . \( -name dispat.yaml -o -name dispat.json \) | sort); do
  set -- "$@" "$f"
done
if [ "$#" -eq 0 ]; then
  echo "no dispat configuration reached the build context" >&2
  exit 1
fi
echo "config scripts: $*"
python3 /src/scripts/lint-config-scripts.py "$@"
EOF
