# syntax=docker/dockerfile:1
ARG GO_VERSION=1.26.10
ARG EXPERIMENTS_IMAGE=dispat-experiments

FROM golang:${GO_VERSION} AS harness
WORKDIR /src
COPY tools/go.mod tools/go.sum ./
RUN GOWORK=off go mod download gopkg.in/yaml.v3
COPY tools/llvmexperiment ./llvmexperiment
COPY tools/internal/executionmeasurement ./internal/executionmeasurement
RUN CGO_ENABLED=0 GOWORK=off go build -trimpath -o /llvmexperiment ./llvmexperiment

FROM golang:${GO_VERSION} AS kernel-source
# Linux v6.18.59, peeled commit; acquisition is outside every timed trial.
RUN git init -q /opt/linux \
 && git -C /opt/linux remote add origin https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git \
 && git -C /opt/linux fetch --depth=1 origin 1253a6aa5d104312bf0992afacc15220ae35bdf9 \
 && git -C /opt/linux checkout -q --detach FETCH_HEAD \
 && test "$(git -C /opt/linux rev-parse HEAD)" = 1253a6aa5d104312bf0992afacc15220ae35bdf9

FROM ${EXPERIMENTS_IMAGE} AS runtime
# All compared executors load these same compiler/tool bytes. GCE uses amd64
# hosts; arm64 is cross-compiled, never substituted with a native-only build.
RUN test "$(uname -m)" = x86_64 \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
      gcc-12 gcc-12-aarch64-linux-gnu binutils-aarch64-linux-gnu libc6-dev \
      make bc bison flex libssl-dev libelf-dev dwarves cpio rsync kmod \
      xz-utils bzip2 lz4 zstd gawk patch pkg-config python3 \
 && dpkg-query -W -f='${binary:Package}\t${Version}\n' > /etc/dispat-kernel-toolchain.tsv \
 && rm -rf /var/lib/apt/lists/*
COPY --from=kernel-source /opt/linux /opt/linux
COPY --from=harness /llvmexperiment /usr/local/bin/llvmexperiment
ENTRYPOINT ["llvmexperiment", "run", "--workload", "linux-kernel"]
