# This package is the one Node project of the pnpm workspace rooted at the
# repository root; nothing in go.work knows it exists.

# Dependencies. The lockfile is the workspace's, at the repository root, and it
# IS tracked; the tree it installs is not.
/node_modules

# Build output and incremental caches, all regenerated by `pnpm run build`.
# The release publishes the built artifact, never a committed copy of it.
/build
/.docusaurus
/.cache-loader

# NOTE: versioned_docs/, versioned_sidebars/ and versions.json are NOT
# ignored.
#
# They look like build output because a script generates them, but they are
# source: the frozen copy of the docs as they stood at 1.0, 1.1, ... written
# once by `docusaurus docs:version` (scripts/cut-docs-version.sh, run from the
# docs package's version stage) and then edited by hand like any other page.
# Ignoring them means every CI build silently rebuilds the site with the
# current docs under every version's URL.

# Misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
