{
  "concurrency": [
    1,
    1
  ],
  "scripts": {
    "build": "cd \"$RELEASE_ROOT\" && pants package \"$PANTS_TARGET\""
  },
  "spaces": {
    "python": {
      "path": "src",
      "autoVersion": {
        "enabled": true,
        "manifests": "none",
        "replace": [
          {
            "files": [
              "BUILD"
            ],
            "find": "version=\"{previous}\"",
            "write": "version=\"{version}\""
          }
        ]
      },
      "flow": {
        "build": "build"
      },
      "packages": {
        "core": {
          "env": {
            "PANTS_TARGET": "src/core:dist"
          }
        },
        "app": {
          "env": {
            "PANTS_TARGET": "src/app:dist"
          },
          "dependencies": [
            {
              "provider": "core",
              "keep": true
            }
          ]
        }
      }
    }
  },
  "initials": {
    "core": "1.0.0",
    "app": "1.0.0"
  }
}
